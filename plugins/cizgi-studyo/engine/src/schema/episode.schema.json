{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cizgi-studyo/episode.schema.json",
  "title": "Episode",
  "description": "A cartoon episode. Every id that refers to a character rig, action, background or camera must exist in the library; validate.mjs checks those references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode",
    "language",
    "characters",
    "scenes"
  ],
  "properties": {
    "episode": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "content_locked": {
      "type": "boolean"
    },
    "profile": {
      "$ref": "#/definitions/id"
    },
    "format": {
      "enum": [
        "16:9",
        "9:16"
      ]
    },
    "kararlar": {
      "description": "Choices the person made before the script approval (cizgi onayla senaryo refuses until all are set and the episode agrees with them): boyut 2b|3b (3b also needs stil3d), muzik var|yok (var: music is set), efekt var|yok (yok: no shot has sfx), altyazi var|yok (yok: altyazi.kapali).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "boyut": { "enum": ["2b", "3b"] },
        "muzik": { "enum": ["var", "yok"] },
        "efekt": { "enum": ["var", "yok"] },
        "altyazi": { "enum": ["var", "yok"] }
      }
    },
    "stil3d": {
      "description": "The look of a 3D render (the 2D render ignores it): toon (flat bands of light and an outline, the default), yumusak (smooth shading and soft shadows), pastel (soft colours, a thin outline, a light shadow), golge (toon bands with a shadow, no outline).",
      "enum": ["toon", "yumusak", "pastel", "golge"]
    },
    "altyazi": {
      "description": "Captions of the whole episode: kapali turns them all off; konusan_rengi edges each caption with its speaker's colour (characters[].renk).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kapali": { "type": "boolean" },
        "konusan_rengi": { "type": "boolean" }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rig"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "name": {
            "type": "string"
          },
          "rig": {
            "$ref": "#/definitions/id"
          },
          "palette": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": {
              "$ref": "#/definitions/color"
            }
          },
          "static_features": {
            "type": "string"
          },
          "renk": {
            "description": "The character's colour in the timeline and on its captions (default: by its place in the cast).",
            "$ref": "#/definitions/color"
          },
          "voice": {
            "$ref": "#/definitions/voice"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "bg",
          "shots"
        ],
        "properties": {
          "scene_id": {
            "$ref": "#/definitions/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "dekor": {
            "description": "Library props standing in the scene for all its shots, behind the characters (a tree, a bench). x in world units; back, olcek and ters as for cast.",
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "prop", "x"],
              "properties": {
                "id": { "$ref": "#/definitions/id" },
                "prop": { "$ref": "#/definitions/id" },
                "x": { "type": "number", "minimum": -600, "maximum": 2520 },
                "back": { "type": "number", "minimum": 0, "maximum": 1 },
                "olcek": { "type": "number", "minimum": 0.3, "maximum": 3 },
                "ters": { "type": "boolean" }
              }
            }
          },
          "katmanlar": {
            "description": "Per-scene settings of the background's layers, by layer id (a one-file background has one layer: tum).",
            "type": "object",
            "maxProperties": 8,
            "propertyNames": {
              "$ref": "#/definitions/id"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gizli": { "type": "boolean" },
                "dx": { "type": "number", "minimum": -960, "maximum": 960 },
                "dy": { "type": "number", "minimum": -540, "maximum": 540 },
                "olcek": { "type": "number", "minimum": 0.5, "maximum": 2 },
                "ton": { "$ref": "#/definitions/color" }
              }
            }
          },
          "altyazi": {
            "description": "Where (alt, ust, orta) and how big (kucuk, orta, buyuk) the scene's captions are. Default: alt in 16:9, ust in 9:16; orta.",
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "konum": { "enum": ["alt", "ust", "orta"] },
              "boyut": { "enum": ["kucuk", "orta", "buyuk"] }
            }
          },
          "isik": {
            "description": "Light and time of day of the scene: a colour grade over its world (not the captions). ogle is the drawing as it is; guc is how strongly (default 1).",
            "type": "object",
            "additionalProperties": false,
            "required": ["saat"],
            "properties": {
              "saat": { "enum": ["sabah", "ogle", "aksam", "gece"] },
              "guc": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "bg": {
            "$ref": "#/definitions/id"
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/shot"
            }
          }
        }
      }
    },
    "new_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "character",
              "action",
              "background",
              "prop",
              "camera"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "narrator_voice": {
      "$ref": "#/definitions/voice"
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track"],
      "description": "Background music from library/muzik under the whole film, faded in and out and turned down while lines are spoken.",
      "properties": {
        "track": { "$ref": "#/definitions/id" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "description": "Default 0.35." },
        "fade_in": { "type": "number", "minimum": 0, "maximum": 10, "description": "Seconds; default 1." },
        "fade_out": { "type": "number", "minimum": 0, "maximum": 10, "description": "Seconds; default 1.5." },
        "duck": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share of the volume kept while a line is spoken; default 0.4." },
        "loop": { "type": "boolean", "description": "Repeat a short track to the end; default true." }
      }
    },
    "mix": {
      "type": "object",
      "additionalProperties": false,
      "description": "Loudness of whole tracks (1 = as recorded).",
      "properties": {
        "lines": { "type": "number", "minimum": 0, "maximum": 1 },
        "sfx": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "cast",
        "camera"
      ],
      "properties": {
        "shot_id": {
          "$ref": "#/definitions/id"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "stale"
          ]
        },
        "utterances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speaker",
              "text"
            ],
            "properties": {
              "speaker": {
                "$ref": "#/definitions/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "audio": {
                "type": "string",
                "description": "Optional. Path relative to the episode folder. When omitted the audio step writes ses/<shot_id>-<n>.wav. Sidecars <name>.words.json and <name>.rhubarb.json are optional."
              },
              "delay": {
                "type": "number",
                "minimum": 0,
                "maximum": 5,
                "description": "Extra seconds of silence before this line (on top of the usual lead or gap)."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Loudness of this line (1 = as recorded)."
              },
              "altyazi": {
                "type": "boolean",
                "description": "false: this line has no caption (default: shown)."
              }
            }
          }
        },
        "cast": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "mark"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "action": {
                "$ref": "#/definitions/id"
              },
              "mark": {
                "enum": [
                  "sol",
                  "orta",
                  "sag"
                ]
              },
              "dx": {
                "type": "number",
                "minimum": -900,
                "maximum": 900,
                "description": "Stand this many world units right (negative: left) of the mark. The marks stay as snapping points; a walk starts from here."
              },
              "back": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How far back the character stands: 0 on the front ground line, 1 as far back as it goes (higher up and smaller, drawn behind those in front)."
              },
              "varyant": {
                "description": "A costume variant of the character's drawing for this shot (character.json varyantlar): parts marked for it show or hide, and its colours apply. Leave it out for the drawing as it is.",
                "type": "string", "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
              },
              "ifade": {
                "description": "The face outside speech: gulumse (smile) or notr, for the whole shot, or a list of moments [{ifade, at}] in seconds from the shot start (neutral before the first). While the character speaks the mouth follows the speech.",
                "oneOf": [
                  { "enum": ["notr", "gulumse"] },
                  {
                    "type": "array", "minItems": 1, "maxItems": 8,
                    "items": {
                      "type": "object", "additionalProperties": false, "required": ["ifade", "at"],
                      "properties": { "ifade": { "enum": ["notr", "gulumse"] }, "at": { "type": "number", "minimum": 0 } }
                    }
                  }
                ]
              },
              "facing": {
                "enum": [
                  "sag",
                  "sol"
                ]
              },
              "from": {
                "type": "number",
                "minimum": 0,
                "description": "Start the action this many seconds in (continue a movement across a cut: cut on action)."
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "description": "Actions played after `action` in the same shot (walk, stop, bend to pick up...): each starts at `at` seconds into the shot, in time order. `action` plays from the start until the first of these.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "at"],
                  "properties": {
                    "action": { "$ref": "#/definitions/id" },
                    "at": { "type": "number", "exclusiveMinimum": 0 },
                    "from": { "type": "number", "minimum": 0, "description": "Start this action part-way in." }
                  }
                }
              },
              "walk": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dx"
                ],
                "description": "Walk dx world units from the mark (negative = left) at constant speed over time seconds (default: the whole shot). Pair with a walk-cycle action.",
                "properties": {
                  "dx": {
                    "type": "number",
                    "description": "Direction and length of the walk: positive walks to the right, negative to the left (someone coming in from the right walks with a negative dx). Set the cast.dx start so the walk ends where they should stop.",
                    "minimum": -1500,
                    "maximum": 1500
                  },
                  "time": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "arrive": {
                    "type": "boolean",
                    "description": "Walk in from dx before the mark and stop on it (instead of starting on the mark)."
                  }
                }
              }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "framing"
          ],
          "properties": {
            "framing": {
              "$ref": "#/definitions/id"
            },
            "move": {
              "$ref": "#/definitions/id"
            },
            "target": {
              "$ref": "#/definitions/id"
            }
          }
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "sfx": {
          "type": "array",
          "description": "Library sound effects played in this shot: at = seconds from the start of the shot.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sfx", "at"],
            "properties": {
              "sfx": { "$ref": "#/definitions/id" },
              "at": { "type": "number", "minimum": 0 },
              "volume": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "notes": {
          "type": "string"
        },
        "props": {
          "type": "array",
          "description": "Library props in this shot. A prop rests on the ground at its mark (+dx world units) until its holder's action reaches its grab time; from then on it is in the holder's hand. A holder whose action has no grab holds it from the start of the shot.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prop"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "prop": {
                "$ref": "#/definitions/id"
              },
              "mark": {
                "enum": [
                  "sol",
                  "orta",
                  "sag"
                ]
              },
              "dx": {
                "type": "number",
                "minimum": -600,
                "maximum": 600
              },
              "holder": {
                "$ref": "#/definitions/id"
              },
              "hand": {
                "enum": [
                  "L",
                  "R"
                ]
              },
              "depth": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "scale"
                ],
                "description": "Place the prop inside the background (background coordinates) instead of at a mark, so a dolly move brings it closer. Use with perspective backgrounds (data-vp).",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3
                  }
                }
              }
            }
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Reference clip (about 10 s, episode-relative) for voice cloning."
        },
        "hazir": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "A ready voice from the library (library/sesler/<id>.wav: kadin, erkek, erkek-kalin, cocuk). voice.ref wins when both are set."
        },
        "exaggeration": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 1.5
        },
        "cfg": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1,
          "description": "Below 0.4 Chatterbox starts adding or mangling words (Faz 0)."
        }
      }
    }
  }
}
