{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cizgi-studyo/episode.schema.json",
  "title": "Episode",
  "description": "A cartoon episode. Every id that refers to a character rig, action, background or camera must exist in the library; validate.mjs checks those references.",
  "type": "object",
  "additionalProperties": false,
  "required": ["episode", "language", "characters", "scenes"],
  "properties": {
    "episode": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string" },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "revision": { "type": "integer", "minimum": 0 },
    "content_locked": { "type": "boolean" },
    "profile": { "type": "string" },
    "format": { "enum": ["16:9", "9:16"] },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rig"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string" },
          "rig": { "$ref": "#/definitions/id" },
          "palette": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
            "additionalProperties": { "$ref": "#/definitions/color" }
          },
          "static_features": { "type": "string" }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "bg", "shots"],
        "properties": {
          "scene_id": { "$ref": "#/definitions/id" },
          "bg": { "$ref": "#/definitions/id" },
          "shots": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/shot" } }
        }
      }
    },
    "new_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "enum": ["character", "action", "background", "prop", "camera"] },
          "note": { "type": "string" }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shot_id", "cast", "camera"],
      "properties": {
        "shot_id": { "$ref": "#/definitions/id" },
        "status": { "enum": ["draft", "approved", "stale"] },
        "utterances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["speaker", "text", "audio"],
            "properties": {
              "speaker": { "$ref": "#/definitions/id" },
              "text": { "type": "string", "minLength": 1 },
              "audio": { "type": "string", "description": "Path relative to the episode folder; .words.json and .rhubarb.json siblings are optional." }
            }
          }
        },
        "cast": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "action", "mark"],
            "properties": {
              "id": { "$ref": "#/definitions/id" },
              "action": { "$ref": "#/definitions/id" },
              "mark": { "enum": ["sol", "orta", "sag"] },
              "facing": { "enum": ["sag", "sol"] }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["framing"],
          "properties": {
            "framing": { "$ref": "#/definitions/id" },
            "move": { "$ref": "#/definitions/id" },
            "target": { "$ref": "#/definitions/id" }
          }
        },
        "hold": { "type": "number", "minimum": 0, "maximum": 10 },
        "notes": { "type": "string" }
      }
    }
  }
}
