{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cizgi-studyo/episode.schema.json",
  "title": "Episode",
  "description": "A cartoon episode. Every id that refers to a character rig, action, background or camera must exist in the library; validate.mjs checks those references.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode",
    "language",
    "characters",
    "scenes"
  ],
  "properties": {
    "episode": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "content_locked": {
      "type": "boolean"
    },
    "profile": {
      "$ref": "#/definitions/id"
    },
    "format": {
      "enum": [
        "16:9",
        "9:16"
      ]
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "rig"
        ],
        "properties": {
          "id": {
            "$ref": "#/definitions/id"
          },
          "name": {
            "type": "string"
          },
          "rig": {
            "$ref": "#/definitions/id"
          },
          "palette": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": {
              "$ref": "#/definitions/color"
            }
          },
          "static_features": {
            "type": "string"
          },
          "voice": {
            "$ref": "#/definitions/voice"
          }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scene_id",
          "bg",
          "shots"
        ],
        "properties": {
          "scene_id": {
            "$ref": "#/definitions/id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "dekor": {
            "description": "Library props standing in the scene for all its shots, behind the characters (a tree, a bench). x in world units; back, olcek and ters as for cast.",
            "type": "array",
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "prop", "x"],
              "properties": {
                "id": { "$ref": "#/definitions/id" },
                "prop": { "$ref": "#/definitions/id" },
                "x": { "type": "number", "minimum": -600, "maximum": 2520 },
                "back": { "type": "number", "minimum": 0, "maximum": 1 },
                "olcek": { "type": "number", "minimum": 0.3, "maximum": 3 },
                "ters": { "type": "boolean" }
              }
            }
          },
          "katmanlar": {
            "description": "Per-scene settings of the background's layers, by layer id (a one-file background has one layer: tum).",
            "type": "object",
            "maxProperties": 8,
            "propertyNames": {
              "$ref": "#/definitions/id"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "gizli": { "type": "boolean" },
                "dx": { "type": "number", "minimum": -960, "maximum": 960 },
                "dy": { "type": "number", "minimum": -540, "maximum": 540 },
                "olcek": { "type": "number", "minimum": 0.5, "maximum": 2 },
                "ton": { "$ref": "#/definitions/color" }
              }
            }
          },
          "bg": {
            "$ref": "#/definitions/id"
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/shot"
            }
          }
        }
      }
    },
    "new_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "character",
              "action",
              "background",
              "prop",
              "camera"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "narrator_voice": {
      "$ref": "#/definitions/voice"
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["track"],
      "description": "Background music from library/muzik under the whole film, faded in and out and turned down while lines are spoken.",
      "properties": {
        "track": { "$ref": "#/definitions/id" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1, "description": "Default 0.35." },
        "fade_in": { "type": "number", "minimum": 0, "maximum": 10, "description": "Seconds; default 1." },
        "fade_out": { "type": "number", "minimum": 0, "maximum": 10, "description": "Seconds; default 1.5." },
        "duck": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share of the volume kept while a line is spoken; default 0.4." },
        "loop": { "type": "boolean", "description": "Repeat a short track to the end; default true." }
      }
    },
    "mix": {
      "type": "object",
      "additionalProperties": false,
      "description": "Loudness of whole tracks (1 = as recorded).",
      "properties": {
        "lines": { "type": "number", "minimum": 0, "maximum": 1 },
        "sfx": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  },
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "cast",
        "camera"
      ],
      "properties": {
        "shot_id": {
          "$ref": "#/definitions/id"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "stale"
          ]
        },
        "utterances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "speaker",
              "text"
            ],
            "properties": {
              "speaker": {
                "$ref": "#/definitions/id"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "audio": {
                "type": "string",
                "description": "Optional. Path relative to the episode folder. When omitted the audio step writes ses/<shot_id>-<n>.wav. Sidecars <name>.words.json and <name>.rhubarb.json are optional."
              },
              "delay": {
                "type": "number",
                "minimum": 0,
                "maximum": 5,
                "description": "Extra seconds of silence before this line (on top of the usual lead or gap)."
              },
              "volume": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "Loudness of this line (1 = as recorded)."
              }
            }
          }
        },
        "cast": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "mark"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "action": {
                "$ref": "#/definitions/id"
              },
              "mark": {
                "enum": [
                  "sol",
                  "orta",
                  "sag"
                ]
              },
              "dx": {
                "type": "number",
                "minimum": -900,
                "maximum": 900,
                "description": "Stand this many world units right (negative: left) of the mark. The marks stay as snapping points; a walk starts from here."
              },
              "back": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "How far back the character stands: 0 on the front ground line, 1 as far back as it goes (higher up and smaller, drawn behind those in front)."
              },
              "facing": {
                "enum": [
                  "sag",
                  "sol"
                ]
              },
              "from": {
                "type": "number",
                "minimum": 0,
                "description": "Start the action this many seconds in (continue a movement across a cut: cut on action)."
              },
              "actions": {
                "type": "array",
                "minItems": 1,
                "description": "Actions played after `action` in the same shot (walk, stop, bend to pick up...): each starts at `at` seconds into the shot, in time order. `action` plays from the start until the first of these.",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["action", "at"],
                  "properties": {
                    "action": { "$ref": "#/definitions/id" },
                    "at": { "type": "number", "exclusiveMinimum": 0 },
                    "from": { "type": "number", "minimum": 0, "description": "Start this action part-way in." }
                  }
                }
              },
              "walk": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dx"
                ],
                "description": "Walk dx world units from the mark (negative = left) at constant speed over time seconds (default: the whole shot). Pair with a walk-cycle action.",
                "properties": {
                  "dx": {
                    "type": "number",
                    "minimum": -1500,
                    "maximum": 1500
                  },
                  "time": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "arrive": {
                    "type": "boolean",
                    "description": "Walk in from dx before the mark and stop on it (instead of starting on the mark)."
                  }
                }
              }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "framing"
          ],
          "properties": {
            "framing": {
              "$ref": "#/definitions/id"
            },
            "move": {
              "$ref": "#/definitions/id"
            },
            "target": {
              "$ref": "#/definitions/id"
            }
          }
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "sfx": {
          "type": "array",
          "description": "Library sound effects played in this shot: at = seconds from the start of the shot.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sfx", "at"],
            "properties": {
              "sfx": { "$ref": "#/definitions/id" },
              "at": { "type": "number", "minimum": 0 },
              "volume": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        },
        "notes": {
          "type": "string"
        },
        "props": {
          "type": "array",
          "description": "Library props in this shot. A prop rests on the ground at its mark (+dx world units) until its holder's action reaches its grab time; from then on it is in the holder's hand. A holder whose action has no grab holds it from the start of the shot.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "prop"
            ],
            "properties": {
              "id": {
                "$ref": "#/definitions/id"
              },
              "prop": {
                "$ref": "#/definitions/id"
              },
              "mark": {
                "enum": [
                  "sol",
                  "orta",
                  "sag"
                ]
              },
              "dx": {
                "type": "number",
                "minimum": -600,
                "maximum": 600
              },
              "holder": {
                "$ref": "#/definitions/id"
              },
              "hand": {
                "enum": [
                  "L",
                  "R"
                ]
              },
              "depth": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y",
                  "scale"
                ],
                "description": "Place the prop inside the background (background coordinates) instead of at a mark, so a dolly move brings it closer. Use with perspective backgrounds (data-vp).",
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 3
                  }
                }
              }
            }
          }
        }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "description": "Reference clip (about 10 s, episode-relative) for voice cloning."
        },
        "exaggeration": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 1.5
        },
        "cfg": {
          "type": "number",
          "minimum": 0.4,
          "maximum": 1,
          "description": "Below 0.4 Chatterbox starts adding or mangling words (Faz 0)."
        }
      }
    }
  }
}
